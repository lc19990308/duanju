<template>
	<view class="page">
		<view class="contentBox" :style="{width:videoStyle.width,height:videoStyle.height}" v-if="contentShow"
			@touchmove="vodViewMove($event)" @touchend="vodViewEnd($event)">
			<list @loadmore="lodData" @scroll="scrolls" :show-scrollbar="false" ref="listBox" :pagingEnabled="true">
				<unirefresh class="refresh" ref="refresh" @refresh="refreshData" :bgStyle="'#000'" :fontColor="'#fff'"
					v-if="loadOpen"></unirefresh>
				<cell v-for="(item,index) in vodList" :key="'myVodEl'+index+swId">
					<view :style="{width:videoStyle.width,height:videoStyle.height}" :ref="'myVodEl'+index+swId">
						<!-- 底层图标 -->
						<view class="vodLayer"
							:style="{width:videoStyle.width,height:videoStyle.height,opacity:item.coverShow?0:1}">
							<image src="/static/icon/sound.png" mode="" class="vodLayer-img"></image>
						</view>
						<view class="vodPlayer" v-if="Math.abs(vodIndex-index) <= 1" :style="{opacity:appoint?0:1}">
							<!-- <video :style="{width:videoStyle.width,height:videoStyle.height}" :src="item.vodUrl"
							:controls="false"
							:enable-progress-gesture="false"
							:page-gesture="false"
							:show-loading="false" 
							:show-play-btn="false" 
							:show-center-play-btn="false"
							:show-fullscreen-btn="false"
							:vslide-gesture-in-fullscreen="false"
							:show-progress="false"
							:object-fit="item.object_fit"
							:http-cache="true"
							:loop="loopPlay"
							:muted="(index == vodIndex && !changeVod && !muteSetup) ? false : true"
							 :id="'myVideo'+index+swId" @play="startPlay(index)" @waiting="bufferVod(index)" @timeupdate="timeupdateVod($event,index)"
							  @error="errVod(index)" @ended="endedVod(index)">
							</video> -->

							<uniVideoPlayer :style="{width:videoStyle.width,height:videoStyle.height}"
								:ref="'myVideo'+index+swId" :src="item.vodUrl" :videoStyle="videoStyle" :item="item"
								:loopPlay="loopVod" :muteSetup="muteSetup" :index="index" :vodIndex="vodIndex"
								:swId="swId" :autoplay="autoplay" :appoint="appoint" :changeVod="changeVod"
								:clickPlay="clickPlay" @loadchange="loadchange(index)"
								@fullScreenChange="fullScreenChange" @play="startPlay(index)"
								@waiting="bufferVod(index)" @timeupdate="timeupdateVod($event,index)"
								@error="errVod(index)" @ended="endedVod(index)" />

						</view>
						<!-- 视频封面-->
						<view class="vodPause-img" v-if="item.coverShow"
							:style="{width:videoStyle.width,height:videoStyle.height,opacity:appoint?0:1}">
							<image :src="item.coverImg" :mode="item.object_fit == 'cover'?'aspectFill':'widthFix'"
								class="cover-img"
								:style="{opacity:item.coverOpacity?1:0,width:videoStyle.width,height:item.object_fit == 'cover'?videoStyle.height:0}">
							</image>
						</view>
						<!-- 暂停图标 -->
						<view class="vodPause-img" v-if="item.pauseShow"
							:style="{width:videoStyle.width,height:videoStyle.height}">
							<image src="/static/icon/vod-play.png" class="vodPauseImage" ref="pauseRef"
								style="opacity: 0;"></image>
						</view>
						<!-- 暂停播放操作层 -->
						<view @click="handClick($event,index)" @touchstart="handClick($event,index)"
							@longpress="longpress(item)" class="vodPlayView" :style="videoStyle">
							<!-- 底部标题、右侧操作栏 -->
							<view :style="{width:videoStyle.width,height:videoStyle.height,opacity:appoint?0:1}">
								<videoMenu :ref="'menuRef'+index" :vodHeight="vodHeight" :vodIndex="vodIndex"
									:item="item" :discussNum="item.totalEpisodes" :index="index"
									:sliderDrag="sliderDrag" :moveOpacity="moveOpacity" :showSelectShow='showSelectShow'
									:style="{width:videoStyle.width,height:videoStyle.height}"
									@pickerVideoPlay='pickerVideoPlay' @fabulousBtn="fabulousBtn"></videoMenu>
							</view>
						</view>
						<!-- 全屏观看 -->
						<view class="fullScreen" v-if="item.fullScreenShow" @click="openScreen(index)"
							:style="{left: (screenWidth/2) - 46.5 + 'px', bottom: vodHeight / 3.4 + 'px'}"
							:class="[vodIndex == index ? (moveOpacity?'vodMenu-bright2':'vodMenu-bright0') : '']">
							<image src="/static/icon/tsp-qp.png" class="fullScreen-icon"></image>
							<text class="fullScreen-text">Xem toàn màn hình</text>
						</view>
					</view>
				</cell>
			</list>
			<view class="flooter" :style="{opacity:moveOpacity ? 0 : 1,bottom:speedBottom+'px'}"
				v-if="vodList.length > 0">
				<!-- 滑动进度条显示时间 -->
				<view class="sliderData" v-if="sliderDrag">
					<view class="slider-text">
						<text
							style="color: #FFFFFF;font-size: 50rpx;font-weight: bold;">{{formatSeconds(sliderTime)}}</text>
						<text style="font-size: 40rpx;margin: 0 10rpx;color: #FFFFFF;">/</text>
						<text
							style="opacity: 0.5;color: #FFFFFF;font-size: 50rpx;font-weight: bold;">{{formatSeconds(videoTime)}}</text>
					</view>
				</view>
				<!-- 进度条 -->
				<view class="sliderBox" :style="{opacity:speedHide ? 0 : 1}" @touchmove="touchmoveSlider"
					@touchstart="touchmoveSlider" @touchend="touchendSlider"
					v-if="vodList.length > 0 && vodList[vodIndex].sliderShow">
					<view class="slider-item" :style="{opacity:!brightSlider ? 1 : 0}">
						<!-- 底层 -->
						<view class="slider-box"></view>
						<!-- 滑块 -->
						<!-- <view class="slider-block" :style="{marginLeft:sliderProgress+'px'}"></view> -->
						<!-- 滑动层 -->
						<view class="slider-load" :style="{width:sliderProgress+'px'}"></view>
					</view>
					<!-- 光亮进度 -->
					<view class="slider-item" :style="{height: '18px',opacity:brightSlider ? 1 : 0}">
						<!-- 底层 -->
						<view class="slider-box slider-box-active"></view>
						<!-- 滑块 -->
						<!-- <view class="slider-block slider-block-active" :style="{marginLeft:sliderProgress+'px'}"></view> -->
						<!-- 滑动层 -->
						<view class="slider-load slider-load-active" :style="{width:sliderProgress+'px'}"></view>
					</view>
				</view>
				<view v-else :style="{width:screenWidth+'px',height:'18px'}"></view>
				<!-- loading加载动画进度 -->
				<view class="loadSlider" v-if="vodList.length > 0 && vodList[vodIndex].loadingShow">
					<view :style="{opacity:brightSlider ? 0 : 1}">
						<view class="loading-slider" ref="loadSlider" :style="{width:screenWidth+'px'}"></view>
					</view>
				</view>
			</view>
			<!-- 点赞桃心 -->
			<view class="doubleImage" v-for="(item,index) in likeList" :key="index" :ref="'peachRef'+item.id"
				:style="{width: item.width+10+'px',height:item.height+10+'px',top:item.top,left:item.left}">
				<image src="/static/icon/selectTaoxin.png" v-if="item.isShow"
					:style="{width: item.width+'px',height:item.height+'px',transform: `rotate(${item.rotate})`}" />
			</view>
		</view>
		<!--付费弹窗-->
		<u-popup :show="pay_show" :closeOnClickOverlay='true' :closeable='true' bgColor='#000'
			@close.stop="pay_show = false" :round="15">
			<view class="pay-popup">
				<view class="pay-popup-head">
					<text class="title">Mở khóa cần {{unlocking_price}} vàng</text>
					<text class="tips">Số dư: {{viperInfo.totalBalance}} vàng</text>
				</view>
				<view class="pay-popup-main">
					<view class="viper-box">
						<view :class="`viper-box-item_${index}`" v-for="(item,index) in viperList" :key="item">
							<text class="name">{{item.packageName}}</text>
							<text class="value">{{item.packagePrice}}</text>
							<image class="viper-icon" src="/static/images/001.png" mode=""></image>
						</view>
					</view>
					<view class="member-box">
						<view class="member-box-item member-box-item_active" v-for="(item,index) in rechargeList"
							:key="index">
							<view class="title">
								<text class="title-value">{{item.rechargeCoins}}</text>
								<text class="title-unit">vàng</text>
							</view>
							<text class="plus">+{{item.giftCoins}}vàng</text>
							<text class="price">${{item.packageMoney}}</text>
						</view>
					</view>
				</view>
			</view>
		</u-popup>
	</view>
</template>
<script>
	import videoJs from './video-n-encipher.js'
	export default videoJs
</script>
<style lang="scss" scoped>
	.page {
		background-color: #000000;
		flex: 1;
		overflow: hidden;
	}

	.contentBox {
		position: relative;
	}

	.swiperBox {
		position: relative;
	}

	.box {
		position: relative;
	}

	.vodLayer {
		position: absolute;
		top: 0;
		left: 0;
		background-color: #000;
		align-items: center;
		justify-content: center;
		flex: 1;
	}

	.vodLayer-img {
		width: 150rpx;
		height: 150rpx;
		opacity: 0.8;
	}

	.cover-img {
		width: 750rpx;
		height: 0;
	}

	.vodPlayer {
		position: absolute;
		top: 0;
		left: 0;
		flex: 1;
	}

	.vodPlayer-video {
		position: absolute;
		top: 0;
		left: 0;
	}

	.vodPlayView {
		position: absolute;
		top: 0;
		left: 0;
		background-color: rgba(0, 0, 0, 0.1);
	}

	.vodPause-img {
		position: absolute;
		top: 0;
		left: 0;
		align-items: center;
		justify-content: center;
		overflow: hidden;
	}

	.vodPauseImage {
		width: 134rpx;
		height: 134rpx;
		opacity: 0.35;
	}

	/* 进度条 */
	.flooter {
		position: absolute;
		bottom: 0;
		left: 0;
		transition-property: opacity;
		transition-timing-function: linear;
		transition-duration: 0.3s;
	}

	.sliderBox {
		position: relative;
		width: 750rpx;
		height: 18px;
	}

	.slider-item {
		height: 2px;
		width: 750rpx;
		position: absolute;
		left: 0;
		bottom: 0;
	}

	.slider-box {
		height: 2px;
		background-color: #C8C7CC;
		opacity: 0.2;
		border-radius: 2px;
	}

	.slider-block {
		position: absolute;
		width: 5px;
		height: 5px;
		border-radius: 5px;
		background-color: #FFFFFF;
		top: -1px;
		left: 0;
		opacity: 0.5;
	}

	.slider-load {
		position: absolute;
		bottom: 0;
		height: 2px;
		width: 0;
		background-color: #FFFFFF;
		opacity: 0.4;
		border-radius: 2px;
		transition-property: opacity;
		transition-timing-function: linear;
		transition-duration: 0.02s;
	}

	.slider-box-active {
		position: absolute;
		width: 750rpx;
		bottom: 0;
		height: 7px;
		background-color: #C8C7CC;
		opacity: 0.4;
		border-radius: 7px;
		transition-property: height;
		transition-timing-function: linear;
		transition-duration: 0.15s;
	}

	.slider-block-active {
		top: 8px;
		width: 15px;
		height: 15px;
		border-radius: 15px;
		opacity: 1;
		left: -3px;
		background-color: #FFFFFF;
	}

	.slider-load-active {
		opacity: 1;
		height: 7px;
		border-radius: 7px;
		transition-property: height;
		transition-timing-function: linear;
		transition-duration: 0.15s;
	}

	.sliderData {
		width: 750rpx;
		height: 200rpx;
		align-items: center;
		justify-content: center;
		color: #FFFFFF;
	}

	.slider-text {
		flex-direction: row;
		align-items: center;
	}

	/* loading加载动画进度 */
	.loadSlider {
		position: absolute;
		bottom: 0px;
		width: 750rpx;
		height: 2px;
		align-items: center;
	}

	.loading-slider {
		width: 0;
		height: 2px;
		background-color: #FFFFFF;
		opacity: 0.9;
	}

	.doubleImage {
		position: absolute;
		top: 0;
		left: 0;
		align-items: center;
		justify-content: center;
		/* ios 在 nvue 上 scale 不能为0 会阻挡点击事件 */
		transform: scale(0.1);
		opacity: 0;
		/* width: 170rpx;
		height: 170rpx; */
	}

	.vodMenu-bright0 {
		opacity: 1;
		transition-property: opacity;
		transition-timing-function: linear;
		transition-duration: 0.3s;
	}

	.vodMenu-bright2 {
		opacity: 0.2;
		transition-property: opacity;
		transition-timing-function: linear;
		transition-duration: 0.3s;
	}

	.fullScreen {
		position: absolute;
		width: 93px;
		/* left: 0;
		right: 0;
		bottom: 30%;
		margin: auto; */
		z-index: 21;
		border: 1px solid rgba(255, 255, 255, 0.2);
		flex-direction: row;
		justify-content: center;
		align-items: center;
		padding: 7px 0;
		border-radius: 30px;
	}

	.fullScreen-icon {
		width: 16px;
		height: 16px;
	}

	.fullScreen-text {
		font-size: 12px;
		color: #FFFFFF;
		margin-left: 5px;
	}

	.pay-popup {
		padding: 30rpx;
	}

	.pay-popup-head {
		margin-top: 40rpx;
		position: relative;

		.title {
			font-weight: 400;
			font-size: 36rpx;
			color: #D1D1D1;
		}

		.tips {
			margin-top: 12rpx;
			font-weight: 400;
			font-size: 28rpx;
			color: #FFCD03;
		}
	}

	.viper-box {
		flex-direction: row;
		justify-content: space-between;
		margin-top: 48rpx;
		flex-wrap: wrap;
	}

	.viper-box-item_0 {
		position: relative;
		width: 327rpx;
		box-sizing: border-box;
		padding: 33rpx 24rpx;
		background: linear-gradient(186deg, rgba(255, 224, 157, 0.4) 0%, rgba(237, 194, 103, 0) 100%);
		border-radius: 16rpx;
		border: 4rpx solid #EDC267;
		margin-bottom: 24rpx;

		.name {
			font-size: 28rpx;
			color: #EDC267;
		}

		.value {
			margin-top: 13rpx;
			font-weight: bold;
			font-size: 36rpx;
			color: #EDC267;
		}

		.viper-icon {
			position: absolute;
			width: 49px;
			height: 41px;
			z-index: 99;
			right: 5px;
			bottom: 5px;
		}
	}

	.viper-box-item_1 {
		position: relative;
		width: 327rpx;
		box-sizing: border-box;
		padding: 33rpx 24rpx;
		background: linear-gradient(186deg, rgba(255, 148, 122, 0.4) 0%, rgba(255, 148, 122, 0) 100%);
		border-radius: 16rpx;
		border: 4rpx solid #FF947A;
		margin-bottom: 24rpx;

		.name {
			font-size: 28rpx;
			color: #FF947A;
		}

		.value {
			margin-top: 13rpx;
			font-weight: bold;
			font-size: 36rpx;
			color: #FF947A;
		}

		.viper-icon {
			position: absolute;
			width: 49px;
			height: 41px;
			z-index: 99;
			right: 5px;
			bottom: 5px;
		}
	}

	.viper-box-item_2 {
		position: relative;
		width: 327rpx;
		box-sizing: border-box;
		padding: 33rpx 24rpx;
		background: linear-gradient(186deg, rgba(226, 122, 255, 0.4) 0%, rgba(226, 122, 255, 0) 100%);
		border-radius: 16rpx;
		border: 4rpx solid #E27AFF;
		margin-bottom: 24rpx;

		.name {
			font-size: 28rpx;
			color: #E27AFF;
		}

		.value {
			margin-top: 13rpx;
			font-weight: bold;
			font-size: 36rpx;
			color: #E27AFF;
		}

		.viper-icon {
			position: absolute;
			width: 49px;
			height: 41px;
			z-index: 99;
			right: 5px;
			bottom: 5px;
		}
	}

	.viper-box-item_3 {
		position: relative;
		width: 327rpx;
		box-sizing: border-box;
		padding: 33rpx 24rpx;
		background: linear-gradient(186deg, rgba(226, 122, 255, 0.4) 0%, rgba(226, 122, 255, 0) 100%);
		border-radius: 16rpx;
		border: 4rpx solid #E27AFF;
		margin-bottom: 24rpx;

		.name {
			font-size: 28rpx;
			color: #E27AFF;
		}

		.value {
			margin-top: 13rpx;
			font-weight: bold;
			font-size: 36rpx;
			color: #E27AFF;
		}

		.viper-icon {
			position: absolute;
			width: 49px;
			height: 41px;
			z-index: 99;
			right: 5px;
			bottom: 5px;
		}
	}

	.viper-box-item_4 {
		position: relative;
		width: 327rpx;
		box-sizing: border-box;
		padding: 33rpx 24rpx;
		background: linear-gradient(186deg, rgba(226, 122, 255, 0.4) 0%, rgba(226, 122, 255, 0) 100%);
		border-radius: 16rpx;
		border: 4rpx solid #E27AFF;
		margin-bottom: 24rpx;

		.name {
			font-size: 28rpx;
			color: #E27AFF;
		}

		.value {
			margin-top: 13rpx;
			font-weight: bold;
			font-size: 36rpx;
			color: #E27AFF;
		}

		.viper-icon {
			position: absolute;
			width: 49px;
			height: 41px;
			z-index: 99;
			right: 5px;
			bottom: 5px;
		}
	}

	.member-box {
		flex-direction: row;
		justify-content: space-between;
		flex-wrap: wrap;
	}

	.member-box-item {
		width: 327rpx;
		margin-bottom: 24rpx;
		box-sizing: border-box;
		border: 2rpx solid #A3A1A6;
		border-radius: 16rpx;

		.title {
			border-radius: 16rpx 16rpx 0 0;
			padding-top: 26rpx;
			text-align: center;
			background-color: #242328;
			flex-direction: row;
			align-items: flex-end;
			justify-content: center;

			.title-value {
				font-size: 32rpx;
				color: #D1D1D1;
			}

			.title-unit {
				margin-left: 7rpx;
				font-size: 26rpx;
				color: #D1D1D1;
			}
		}

		.plus {
			padding: 6rpx 0;
			text-align: center;
			font-weight: 400;
			font-size: 26rpx;
			color: #FFCD03;
			background-color: #242328;
		}

		.price {
			padding: 8rpx 0;
			text-align: center;
			font-size: 30rpx;
			color: #D1D1D1;
			background-color: #3F3E40;
			border-radius: 0 0 16rpx 16rpx;
		}
	}

	.member-box-item_active {
		width: 327rpx;
		margin-bottom: 24rpx;
		box-sizing: border-box;
		border: 2rpx solid #EDC267;

		.title {
			border-radius: 16rpx 16rpx 0 0;
			padding-top: 26rpx;
			text-align: center;
			background-color: #242328;
			flex-direction: row;
			align-items: flex-end;
			justify-content: center;

			.title-value {
				font-size: 32rpx;
				color: #D1D1D1;
			}

			.title-unit {
				margin-left: 7rpx;
				font-size: 26rpx;
				color: #D1D1D1;
			}
		}

		.plus {
			padding: 6rpx 0;
			text-align: center;
			font-weight: 400;
			font-size: 26rpx;
			color: #FFCD03;
			background-color: #242328;
		}

		.price {
			padding: 8rpx 0;
			text-align: center;
			font-size: 30rpx;
			color: #000000;
			background-color: #EDC267;
			border-radius: 0 0 16rpx 16rpx;
		}
	}
</style>