{
    // launch.json 配置了启动调试时相关设置，configurations下节点名称可为 app-plus/h5/mp-weixin/mp-baidu/mp-alipay/mp-qq/mp-toutiao/mp-360/
    // launchtype项可配置值为local或remote, local代表前端连本地云函数，remote代表前端连云端云函数
    "version" : "0.0",
    "configurations" : [
        {
            "app-plus" : {
                "launchtype" : "local"
            },
            "default" : {
                "launchtype" : "local"
            },
            "h5" : {
                "launchtype" : "local"
            },
            "mp-toutiao" : {
                "launchtype" : "local"
            },
            "mp-weixin" : {
                "launchtype" : "local"
            },
            "provider" : "aliyun",
            "quickapp-union" : {
                "launchtype" : "local"
            },
            "type" : "uniCloud"
        },
        {
            "openVueDevtools" : false,
            "type" : "uni-app:miniProgram"
        },
        {
            "openVueDevtools" : true,
            "type" : "uni-app:app-ios"
        },
        {
            "customPlaygroundType" : "local",
            "localRepoPath" : "/Users/liuchao/code/duanju/dj-app/h5/unpackage/debug",
            "openVueDevtools" : true,
            "packageName" : "com.monkey.shortdramaapp.ios",
            "playground" : "custom",
            "type" : "uni-app:app-android"
        }
    ]
}
